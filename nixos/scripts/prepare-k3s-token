#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  prepare-k3s-token [token-file]
  prepare-k3s-token --from-host ashpex@192.168.1.110
  ssh -t ashpex@192.168.1.110 'sudo cat /var/lib/rancher/k3s/server/token' | prepare-k3s-token

Writes:
  ${NIXIE_EXTRA_FILES:-$HOME/.config/homelab/nixie-extra-files}/etc/rancher/k3s/node-token
EOF
}

extra_files="${NIXIE_EXTRA_FILES:-$HOME/.config/homelab/nixie-extra-files}"
from_host=""
remote_token_path="/var/lib/rancher/k3s/server/token"
token_file=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --from-host)
      from_host="${2:-}"
      shift 2
      ;;
    --remote-token-path)
      remote_token_path="${2:-}"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --*)
      echo "Unknown option: $1" >&2
      usage
      exit 2
      ;;
    *)
      if [[ -n "$token_file" ]]; then
        usage
        exit 2
      fi
      token_file="$1"
      shift
      ;;
  esac
done

if [[ -n "$from_host" && -n "$token_file" ]]; then
  echo "--from-host cannot be used with a local token file" >&2
  usage
  exit 2
fi

token_dir="$extra_files/etc/rancher/k3s"
token_path="$token_dir/node-token"
tmp="$(mktemp)"

trap 'rm -f "$tmp"' EXIT

if [[ -n "$from_host" ]]; then
  remote_tmp="/tmp/k3s-server-token"
  ssh -tt "$from_host" "sudo cp '$remote_token_path' '$remote_tmp' && sudo chown \$(id -un):\$(id -gn) '$remote_tmp' && chmod 600 '$remote_tmp'"
  scp "$from_host:$remote_tmp" "$tmp"
  ssh "$from_host" "rm -f '$remote_tmp'"
elif [[ -n "$token_file" ]]; then
  cp "$token_file" "$tmp"
elif [[ -t 0 ]]; then
  usage
  exit 2
else
  cat > "$tmp"
fi

if [[ ! -s "$tmp" ]]; then
  echo "K3s node token is empty" >&2
  exit 1
fi

mkdir -p "$token_dir"
install -m 0600 "$tmp" "$token_path"

echo "Wrote $token_path"
